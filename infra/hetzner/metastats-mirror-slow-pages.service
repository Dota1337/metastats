[Unit]
Description=metastats Route-Spiegel /marktwert, /tft/tournaments, /lol (Kennzahlen) als Blob-Datei
Wants=network-online.target
After=network-online.target
# Gestartet von metastats-mirror-slow-pages.timer alle 3 h (Soft-404-Plan
# 26.10.2026). Die Quellen aendern sich taeglich bzw. woechentlich.

[Service]
# Keine Riot-Anfragen, keine DB-Verbindung: ruft die oeffentlichen Routen
# (Publisher-Kopfzeile) und schreibt mirror/lolMarktwert|tftTournaments|lolHome/
# in den Blob.
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# Erwartet unter 1 min (3 Abrufe, LoL-Marktwert live bis ~5 s).
TimeoutStartSec=10min
ExecStart=/usr/bin/node scripts/publish-route-mirrors.mjs --group=slow-pages
StandardOutput=journal
StandardError=journal
Nice=15
MemoryMax=300M

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
