[Unit]
Description=metastats Laufzeit-Vertraege (produzieren die Pipelines, was sie versprechen?)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
TimeoutStartSec=300
# Exit != 0 bei Vertragsbruch ist hier ERWUENSCHT: die Unit taucht dann in
# `systemctl --failed` auf, das ist der Sichtbarkeits-Mechanismus. Deshalb darf
# an dieser Unit NIEMALS ein OnSuccess= haengen und sie darf in keiner Kette
# stehen — sonst wuerde ein gemeldeter Bruch eine Pipeline stoppen.
ExecStart=/usr/bin/node scripts/check-contracts.mjs --out /var/lib/metastats/contracts-status.json
StandardOutput=journal
StandardError=journal

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
# Ausnahmen dieser Unit (stehen bewusst NACH dem Boden — systemd nimmt
# bei Nicht-Listen-Direktiven die letzte Zuweisung):
#   contracts-status.json. StateDirectory statt ReadWritePaths, weil systemd das Verzeichnis dann auch anlegt.
StateDirectory=metastats

[Install]
WantedBy=multi-user.target
