[Unit]
Description=metastats npm ci nachholen, wenn node_modules nicht zum package-lock.json passt (nur im Leerlauf)
# Warum es diese Unit gibt (2026-10): der Deploy ueberspringt npm ci, solange
# ein Crawl laeuft — und die Box crawlt fast rund um die Uhr. Ohne Nachholung
# blieb node_modules vom 14.08. bis Oktober stehen. Die Logik (Vergleich gegen
# den installierten Stand, "laeuft ein Job -> kein npm ci", Sperre gegen einen
# gleichzeitigen Deploy) steht EINMAL in remote-deploy.sh, hier nur der Aufruf.

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
# Die Kopie auf der Platte, nicht eine nach /usr/local/bin kopierte: jeder
# Deploy bringt so automatisch die aktuelle Fassung mit.
# "+" = ohne Sandbox, und das ist hier Absicht: npm ci muss sich exakt so
# verhalten wie im Deploy (root per ssh, ohne Sandbox). Mit ProtectHome=yes
# fehlte der npm-Cache unter /root/.npm, und die Installations-Skripte von
# better-sqlite3, onnxruntime-node und @sentry/cli laden Binaries nach —
# scheitert npm ci mittendrin, ist node_modules halb geloescht und jeder
# Crawl stirbt beim Start.
ExecStart=+/bin/bash /opt/metastats-crawler/infra/hetzner/remote-deploy.sh --deps-only
# Gemessen ~1,6 GB node_modules. 30 min sind grosszuegig; ein haengendes
# npm ci darf die Sperre aber nicht ewig halten, sonst wartet jeder Deploy.
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
