[Unit]
Description=metastats TFT marketvalue crawler (Master+ daily)
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
# Phase-A3 Auto-Cascade: nach Bootstrap-Region(en) sofort den Daily-Snapshot-
# Service für ALLE anderen Regionen triggern, damit jede Region täglich
# einmal aktualisiert wird statt nur die Bootstrap-Tagesregion. Der
# Snapshot-Service ist Cursor-aware: schon-fertige Regionen werden geskippt.
# Conflicts= in marketvalue-snapshot.service schützt gegen Doppelläufe.
OnSuccess=metastats-marketvalue-snapshot.service
# Failure-Cascade-Schutz (Logic-Flow-Critic 2026-06-20): wenn der Bootstrap
# scheitert (non-zero exit), würde OnSuccess NICHT feuern und die Snapshot-
# Pipeline läuft die Nacht stillschweigend nie. OnFailure fängt das ab — die
# Snapshot-Pipeline ist idempotent (Cursor + Backup) und schadet nicht wenn
# sie nach einem Bootstrap-Fail noch versucht die Regionen zu refreshen.
OnFailure=metastats-marketvalue-snapshot.service

[Service]
# No artificial cap — a full Diamond-II+ crawl can legitimately run many hours;
# the only time limits are riot-client's per-request timeout + rate limits.
TimeoutStartSec=infinity
# Graceful-stop headroom: the child catches SIGTERM to flush Pass 2 + persist;
# give it 10 min before SIGKILL (default 90s could cut the flush short).
TimeoutStopSec=600
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# --region-timeout=0 disables the per-region kill on legacy box code; current
# code has no per-region timeout (the arg is a harmless no-op there).
ExecStart=/usr/bin/node scripts/crawl-all-regions.mjs --include-diamond --region-timeout=0
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
# Ausnahmen dieser Unit (stehen bewusst NACH dem Boden — systemd nimmt
# bei Nicht-Listen-Direktiven die letzte Zuweisung):
#   mv-region-cursor.json. writeCursor schluckt Fehler -> Region-Rotation faellt sonst still auf euw1 zurueck.
ReadWritePaths=/etc/metastats-crawler
