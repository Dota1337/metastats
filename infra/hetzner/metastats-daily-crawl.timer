[Unit]
Description=Daily TFT all-ranks crawl — fires 00:00 UTC, runs as long as needed

[Timer]
# 00:00 UTC start. There is no time cap on the run — the crawler keeps going
# until every region is finished, however long that takes. If a run ever crosses
# UTC midnight, the OnSuccess= chain in the .service triggers a catch-up run
# so the skipped day's 00:00 trigger is not lost.
OnCalendar=*-*-* 00:00:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
