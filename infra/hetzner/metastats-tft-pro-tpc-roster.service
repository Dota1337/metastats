[Unit]
Description=TFT TPC Pro-Circuit Roster Crawler (Liquipedia → tpc_verified flag)
After=network-online.target
Wants=network-online.target
# After it finishes, classify pros so the tpc_verified flag immediately
# propagates into classification + confidence_score.
OnSuccess=metastats-tft-pro-classify.service

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
ExecStart=/usr/bin/node scripts/crawl-tft-tpc-roster.mjs
TimeoutStartSec=infinity
TimeoutStopSec=300

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
# Ausnahmen dieser Unit (stehen bewusst NACH dem Boden — systemd nimmt
# bei Nicht-Listen-Direktiven die letzte Zuweisung):
#   Resume-Cache nach 429-Abbruch liegt in /tmp und soll 6h ueberleben. Mit PrivateTmp waere er pro Lauf frisch, der 429-Schutz also tot.
PrivateTmp=no

[Install]
WantedBy=multi-user.target
