[Unit]
Description=metastats daily-crawl watchdog (16:00 / 20:00 / 23:00 UTC)
# Daily-crawl starts 05:45 UTC (seit 2026-09-13), ~10h -> ~16:00 done. Laeuft
# er dann noch, ueberspringt der 16:00-Tick (is-active-Check im Skript) und
# 20:00/23:00 greifen. Alle drei Ticks peilen denselben Tag an wie der Lauf
# (resolveDailyTargetDay ist von 05:00 bis 05:00 konstant).
# 20:00 + 23:00 are safety ticks: if an earlier tick still found the crawl
# running and skipped, a later one retries before the day ends. (Residual gap:
# a crawl that runs past 23:00 won't be resumed that day — very rare; the
# catch-up service handles the separate midnight-crossing case.)

[Timer]
OnCalendar=*-*-* 16:00:00 UTC
OnCalendar=*-*-* 20:00:00 UTC
OnCalendar=*-*-* 23:00:00 UTC
# Persistent=false ON PURPOSE: a missed recovery tick has little value to catch
# up hours later, and Persistent=true would fire an immediate kick on first
# enable. On day one there is no cursor yet, so an immediate kick would see
# "all 15 regions todo" and launch a full 14h crawl on top of the day's run.
# A recovery watchdog must wait for its next real tick instead.
Persistent=false
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
