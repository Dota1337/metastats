[Unit]
Description=Daily TFT all-ranks crawl — starts 00:00 UTC so all regions are fresh by late morning

[Timer]
# 00:00 UTC start: the all-regions pass runs ~9h worst-case, so it finishes
# by ~09:00 UTC (~11:00 CEST) with every region crawled before the European
# daytime traffic peaks. Giving it the full night is what guarantees "all
# regions done by the forenoon".
#
# Shared TFT prod-key bucket: there is NO separate marketvalue timer anymore
# (metastats-crawler.timer is masked). The marketvalue crawl runs only via
# OnSuccess= chained to this unit, and Conflicts= in this unit's .service
# guarantees the two never overlap on the key.
OnCalendar=*-*-* 00:00:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
