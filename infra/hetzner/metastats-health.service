[Unit]
Description=metastats Health-Probe (API + Supabase) + Auto-Restart
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
ExecStart=/usr/bin/node /opt/metastats-crawler/scripts/health-monitor.mjs
TimeoutStartSec=180
# Kein SuccessExitStatus mehr (seit 2026-08-16): Exit 1 heisst hier "der Monitor
# selbst ist kaputt" (State nicht schreibbar, Restart-API unerreichbar, Crash) —
# ein Zielsystem-Ausfall meldet sich per Webhook und laesst die Unit gruen. Der
# Timer feuert unabhaengig vom Ergebnis weiter, die Unit hat kein Restart=.

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
# Ausnahmen dieser Unit (stehen bewusst NACH dem Boden — systemd nimmt
# bei Nicht-Listen-Direktiven die letzte Zuweisung):
#   Health-State.
StateDirectory=metastats-health

[Install]
WantedBy=multi-user.target
