#!/bin/sh
# Pre-push hook for metastats.
# Install: `npm run setup-hooks` (copies this file into .git/hooks/pre-push)
# Skip:    `git push --no-verify`  (explicit opt-out only)
#
# Seven gates:
#   1. TypeScript type-check        — catches obvious code regressions
#   2. Unit tests                   — node --test, catches logic regressions in
#                                     the pure lib functions
#   3. snapshot-matrix freshness    — catches Auto-Generate-Drift
#   4. Classification verifier      — catches Augment/Item/God classification
#                                     regressions against ground-truth.
#                                     See scripts/verify-classifications.mjs
#   5. system-map freshness         — catches luegende Architektur-Doku
#   6. Out-of-band drift            — catches Region-Listen + Set-Literale
#   7. Roh-Hex-Utilities            — catches Rueckfall auf -[#hex] statt Token

set -e

# Gate 0: der Hook prueft seine eigene Veraltung. .git/hooks wird nicht
# gesynct und nichts triggert setup-hooks automatisch — ohne diese Zeile
# pusht Workstation 2 stumm mit einem alten Hook weiter.
if [ -f infra/git-hooks/pre-push ] && ! cmp -s "$0" infra/git-hooks/pre-push; then
  echo ""
  echo "Installierter Hook weicht von infra/git-hooks/pre-push ab — push blocked."
  echo "Run: npm run setup-hooks"
  exit 1
fi

echo "[pre-push 1/7] Running tsc --noEmit ..."
if ! npx tsc --noEmit; then
  echo ""
  echo "TypeScript errors detected — push blocked."
  exit 1
fi
echo "  tsc passed."

echo "[pre-push 2/7] Running unit tests ..."
# Frueh in der Kette: die Tests laufen in <1s und haengen an nichts, was die
# spaeteren Gates tun. Ein roter Test soll nicht hinter 60s tsc+Verifier warten.
if ! npm test; then
  echo ""
  echo "Unit tests failed — push blocked."
  exit 1
fi
echo "  unit tests passed."

echo "[pre-push 3/7] Checking snapshot-matrix.generated.mjs freshness ..."
# Wenn snapshot-matrix.ts neuer ist als die generated.mjs, ist der commit stale.
# Schützt gegen Drift im Auto-Generate-Pattern (reference_dual_module_patterns.md).
if [ -f app/lib/snapshot-matrix.ts ] && [ -f app/lib/snapshot-matrix.generated.mjs ]; then
  if [ app/lib/snapshot-matrix.ts -nt app/lib/snapshot-matrix.generated.mjs ]; then
    echo ""
    echo "snapshot-matrix.ts ist neuer als snapshot-matrix.generated.mjs — push blocked."
    echo "Run: npm run build:snapshot-matrix && git add app/lib/snapshot-matrix.generated.mjs"
    exit 1
  fi
fi
echo "  snapshot-matrix freshness OK."

echo "[pre-push 4/7] Running classification verifier ..."
if ! node scripts/verify-classifications.mjs; then
  echo ""
  echo "Classification checks failed — push blocked."
  echo "If this is intentional, re-run scripts/refresh-augment-tiers.mjs +"
  echo "scripts/fetch-tft-assets.mjs to refresh ground-truth, then retry."
  exit 1
fi
echo "  classification checks passed."

echo "[pre-push 5/7] Checking system-map freshness + broken chains ..."
# Die Karte wird generiert. Wer eine Unit anfasst und sie nicht neu baut,
# bekommt eine Architektur-Doku, die luegt — schlimmer als keine.
if ! node scripts/build-system-map.mjs --check; then
  echo ""
  echo "system-map veraltet — push blocked."
  echo "Run: npm run build:system-map && git add infra/system-map.json"
  exit 1
fi
# Kaputte Ketten (ExecStart auf fehlendes Script, OnSuccess auf unbekannte
# Unit, Timer ohne Ziel) sind Fehler. Hinweise (verwaiste Scripts, fehlende
# Vertraege) blocken bewusst nicht — sonst wird der Hook abgeschaltet.
if ! node scripts/check-system-map.mjs > /dev/null; then
  node scripts/check-system-map.mjs
  echo ""
  echo "Kaputte Referenzen in der Systemkarte — push blocked."
  exit 1
fi
echo "  system-map OK."

echo "[pre-push 6/7] Checking out-of-band region-list drift ..."
if ! node scripts/check-drift.mjs; then
  echo ""
  echo "Region-list drift detected — push blocked."
  echo "Sync the listed files with scripts/lib/active-regions.mjs, then retry."
  exit 1
fi
echo "  region-list drift check passed."

echo "[pre-push 7/7] Checking raw-hex utilities in markup ..."
# Ratsche, kein Verbot: die migrierten 10 Farben sind hart auf Null, der noch
# offene Rest (Accent, Win/Loss) darf nur nicht wachsen. Siehe Kommentarkopf
# in scripts/check-raw-hex-utilities.mjs.
if ! node scripts/check-raw-hex-utilities.mjs; then
  echo ""
  echo "Roh-Hex-Utilities im Markup — push blocked."
  exit 1
fi

echo "[pre-push] all checks green."
