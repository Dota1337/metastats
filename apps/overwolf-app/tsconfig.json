{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["@overwolf/types"]
  },
  "include": ["src/**/*.ts", "vite.config.ts", "../../app/lib/i18n-companion.ts", "../../app/lib/companion-types.ts"]
}
