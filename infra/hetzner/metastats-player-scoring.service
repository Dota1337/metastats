[Unit]
Description=metastats Spieler-Bewertung: Lobby-Raenge nachtragen und Bezugswerte bauen (/tft/compare)
Wants=network-online.target
After=network-online.target
# Wartet auf einen laufenden npm-ci-Nachholer (Timer 05:16:30), statt mitten in
# einem geloeschten node_modules zu starten. Nur Reihenfolge, kein Wants: laeuft
# der Nachholer nicht (oder ist schon fertig), startet diese Unit sofort. Die
# Wartezeit zaehlt nicht gegen TimeoutStartSec (gemessen: JobTimeoutUSec=infinity).
After=metastats-deps-catchup.service

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# Die Sammler gehen vor: niedrigste Prioritaet, harte Speichergrenze (Node-Heap
# darunter, damit Node sauber abbricht statt vom Kernel beendet zu werden).
# Bedarf waechst mit dem Set (~5 MB/Tag: 01.11. 439 MB, 16.11. 518 MB); die
# alte Grenze 500M/420 MB vom 3-GB-Server riss ab 15.11. taeglich. Seit 23.11.2026
# 2G/1536 MB (CPX32, 7,7 GB; frei um 05:17 UTC gemessen ~6,1 GB).
Nice=19
IOSchedulingClass=idle
MemoryMax=2G
TimeoutStartSec=60min
ExecStart=/usr/bin/node --max-old-space-size=1536 scripts/build-player-scoring-population.mjs
StandardOutput=journal
StandardError=journal

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---

[Install]
WantedBy=multi-user.target
