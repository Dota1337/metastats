[Unit]
Description=metastats TFT daily stats crawl (all regions, all ranks)
Wants=network-online.target
After=network-online.target
# Mutual exclusion with the marketvalue crawl. Both consume the single shared
# TFT prod-key bucket (500/10s), so they must NEVER run concurrently — when they
# did, the heavy all-ranks aggregate crawl starved the marketvalue crawl in a
# permanent 429 storm (the D2+ cold-fill runs >24h and overran into the next
# 00:00 firing of this timer). Conflicts= makes starting this daily crawl
# gracefully stop a still-running marketvalue crawl: collect-tft-marketvalues
# catches SIGTERM, flushes Pass 2 + persists partial progress within
# TimeoutStopSec, and the region cursor (see crawl-all-regions.mjs) means the
# interrupted region simply resumes — warm-cached — on the next chained run.
Conflicts=metastats-crawler.service
# Chain the marketvalue crawl (Diamond II+) to run right after this aggregate
# crawl succeeds — single timer, no separate 04:00 schedule. By the time this
# fires, this unit is already inactive, so Conflicts= above does not block it.
# The marketvalue unit carries --include-diamond and its own timeouts.
OnSuccess=metastats-crawler.service

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# No artificial cap — let every region finish; the only time limits are
# riot-client's per-request timeout + rate limits.
TimeoutStartSec=infinity
# Graceful-stop headroom: the child catches SIGTERM to write partial aggregates;
# give it 10 min before SIGKILL (default 90s could cut the write short).
TimeoutStopSec=600
# --region-timeout=0 disables the per-region kill on legacy box code; current
# code has no per-region timeout (the arg is a harmless no-op there).
ExecStart=/usr/bin/node scripts/crawl-allranks-all-regions.mjs --mode auto --region-timeout=0
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort

[Install]
WantedBy=multi-user.target
