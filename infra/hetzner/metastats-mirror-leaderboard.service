[Unit]
Description=metastats Route-Spiegel /tft/leaderboard (Seite 1 der Standardansichten als Blob-Datei)
Wants=network-online.target
After=network-online.target
# Gestartet von metastats-mirror-leaderboard.timer alle 10 min (User 18.10.2026).
# Laeuft ein Lauf laenger, ueberspringt der Timer den naechsten Termin statt
# doppelt zu starten (oneshot).

[Service]
# Keine Riot-Anfragen von der Box: die Route auf Vercel holt die Ligen wie bei
# jedem Besuch (Publisher-Kopfzeile), die Box legt nur die Antwort ab.
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# Erwartet ~1 min (18 Abrufe nacheinander, Welt-Liste ~10 s). 8 min, damit ein
# haengender Abruf (Riot 429, bis zu 3 Wiederholungen) nicht den naechsten
# Termin schluckt.
TimeoutStartSec=8min
ExecStart=/usr/bin/node scripts/publish-route-mirrors.mjs --group=leaderboard
StandardOutput=journal
StandardError=journal
Nice=15
MemoryMax=300M

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
