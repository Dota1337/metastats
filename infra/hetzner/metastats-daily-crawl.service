[Unit]
Description=metastats TFT daily stats crawl (all regions, all ranks)
Wants=network-online.target
After=network-online.target
# Conflicts= bidirektional: wenn daily-crawl um 00:00 UTC startet, wird ein
# eventuell noch laufender Bootstrap-Crawler sauber via SIGTERM gestoppt
# (Cursor in /etc/metastats-crawler/mv-region-cursor.json bleibt erhalten).
Conflicts=metastats-crawler.service
# Catch-up hook: if this run crossed UTC midnight, the next 00:00 OnCalendar
# trigger was swallowed (systemd ignores triggers while a Type=oneshot service
# is still active). The catch-up service detects that and starts another run
# immediately so we never lose a day's aggregation.
OnSuccess=metastats-daily-crawl-catchup.service
# Snapshot publisher wird NICHT mehr via OnSuccess getriggert (Audit HIGH-1,
# 2026-06-28): der Driver ruft den Publisher selbst, aber nur wenn er real >=1
# Region gecrawlt hat (done > 0) — einheitlich für den 00:00-Lauf und die
# --resume-gaps-Resumes, ohne No-Op-Publishes.
# Phase A5 vollzogen (2026-08-01): der Bootstrap-Crawler ist RAUS aus der
# Nacht-Kette, der Marktwert-Snapshot haengt jetzt direkt dran.
#
# Warum: der Bootstrap (Phase A3, 2026-06-20) ist seit dem 2026-06-30 durch —
# mv-region-cursor steht auf la2, alle 15 Regionen haben Snapshots. Er lief
# aber weiter und brauchte 668 min. Zusammen mit den ~14h des Daily-Crawls
# waren das ~25h, also MEHR als das 24h-Fenster: der Marktwert-Snapshot kam in
# der Kette faktisch nie dran und schrieb zuletzt 6-8 statt ~52.000 Snapshots
# pro Tag. Mit diesem Switch bekommt er den Block von ~14:00 bis 00:00 UTC.
#
# metastats-crawler.service bleibt bestehen (static) fuer die woechentliche
# Aufsteiger-Discovery per manuellem/Sonntags-Trigger — nur eben nicht mehr
# jede Nacht. Der Timer war und bleibt masked.
# 2026-06-16 wurde diese Kette versehentlich entfernt → Pipeline 4 Tage still.
# Deshalb: diese Zeile NICHT loeschen, sondern nur ihr Ziel wechseln.
OnSuccess=metastats-marketvalue-snapshot.service

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# No artificial cap — let every region finish; the only time limits are
# riot-client's per-request timeout + rate limits.
TimeoutStartSec=infinity
# Graceful-stop headroom: the child catches SIGTERM to write partial aggregates;
# give it 10 min before SIGKILL (default 90s could cut the write short).
TimeoutStopSec=600
# --region-timeout=0 disables the per-region kill on legacy box code; current
# code has no per-region timeout (the arg is a harmless no-op there).
ExecStart=/usr/bin/node scripts/crawl-allranks-all-regions.mjs --mode auto --region-timeout=0
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
# Ausnahmen dieser Unit (stehen bewusst NACH dem Boden — systemd nimmt
# bei Nicht-Listen-Direktiven die letzte Zuweisung):
#   Tages-Cursor (lib/daily-crawl-cursor.mjs) + Advisory-Lock. Cursor-Schreibfehler wird geschluckt -> ohne das hier laeuft der Crawl still ins Leere.
ReadWritePaths=/etc/metastats-crawler /run/lock

[Install]
WantedBy=multi-user.target
