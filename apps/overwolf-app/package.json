{
  "name": "metastats-overwolf-app",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node --test \"src/**/*.test.ts\" && vite build && node build-opk.mjs",
