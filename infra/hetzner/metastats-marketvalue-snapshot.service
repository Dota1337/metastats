[Unit]
Description=metastats TFT marketvalue daily snapshot (D2+, all active regions)
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
# Wir teilen den Riot-Key mit mehreren Services. Conflicts= verhindert Doppelläufe
# die im selben App-Wide-Limit-Bucket (500/10s) sitzen würden:
#   - daily-crawl + pro-fullsync sind die regulären Geschwister-Crawls
#   - crawler.service ist der Bootstrap-Sweep (Phase A3, temporär)
Conflicts=metastats-daily-crawl.service
Conflicts=metastats-crawler.service
Conflicts=metastats-tft-pro-fullsync.service

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# Sub-Region-Resume scharf (2026-08-01). Ohne das verwirft JEDER Abbruch die
# komplette Gather-Arbeit der laufenden Region — bei euw1 sind das ~6h und
# ~10.000 Riot-Call-Ketten. Der Lauf wird um 00:00 UTC durch das Conflicts=
# des Daily-Crawls beendet, der Fall tritt also planmaessig taeglich ein.
#
# Der Schalter stand seit 2026-06-25 bewusst auf Default false, weil
# buildPopulation.expectedDmg eine reihenfolgesensitive Float-Summe ist und ein
# Resume-Mix theoretisch eine andere Population erzeugen koennte als ein Lauf
# am Stueck. Abnahme dazu gefahren am 2026-08-01:
# `node scripts/verify-inflight-determinism.mjs` -> PASS, A/B/C byte-identisch
# (C ist exakt der Inflight-Mix). Der puuid-Sort vor buildPopulation traegt.
#
# Residual: die Live-Demo mit Mid-Run-SIGKILL gegen die echte DB steht aus —
# der deterministische Test deckt die Mathematik ab, nicht den DB-Roundtrip.
# Bei Auffaelligkeiten in den Multiplier-Verteilungen: hier auf false und
# neu starten, das ist der 60-Sekunden-Rollback.
Environment=MV_USE_INFLIGHT_RESUME=true
# Per-Region-Iteration läuft sequenziell durch 15 Regionen. Realistische
# Laufzeit (Multi-Review-Verdict 2026-06-19): 1-3h Steady-State, bis zu 4-6h
# am Patch-Day. Kein artificial cap — riot-client gated den Rate sauber.
TimeoutStartSec=infinity
# Graceful-stop headroom: der Child fängt SIGTERM und schließt die aktuelle
# Region sauber ab (= Backup-Table erhalten, kein partial-Snapshot-Salat).
TimeoutStopSec=600
ExecStart=/usr/bin/node scripts/daily-marketvalue-snapshot.mjs --region all
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---

[Install]
WantedBy=multi-user.target
