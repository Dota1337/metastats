[Unit]
Description=TFT Pro Full-Sync — Liquipedia crawl + TPC roster + enrich + classify
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
ExecStart=/usr/bin/node scripts/validate-tft-pros-loop.mjs --mode=weekly-full --open-issues
# Liquipedia rate-limit + 4-step pipeline can take ~45 min; cap at 2h.
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
