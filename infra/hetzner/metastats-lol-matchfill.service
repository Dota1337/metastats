[Unit]
Description=metastats LoL match fill (dauerhafte Match-Ablage je Spieler; kicked by refresh-riot-key.mjs after a key rotation)
Wants=network-online.target
After=network-online.target metastats-lol-marketvalue.service

[Service]
# Kein Timer, gleiche Begruendung wie bei metastats-lol-marketvalue.service:
# der LoL-Dev-Key laeuft alle 24h ab, ein fester Zeitplan feuert fast immer mit
# einem toten Key. refresh-riot-key.mjs startet diese Unit direkt nachdem der
# frische Key gegen Riot validiert wurde.
#
# Bewusst KEIN Conflicts=metastats-lol-marketvalue.service: Conflicts wirkt in
# beide Richtungen und wuerde diesen Lauf bei jeder Key-Rotation abschiessen.
# Die Koordination laeuft ueber die gemeinsame Sperre /run/lock/metastats-lol-riot.lock,
# die der Sammler PRO SPIELER nimmt und zwischen den Spielern wieder freigibt.
Type=oneshot
# Riot erlaubt 100 Anfragen pro 2 Minuten fuer den ganzen Key, der Sammler nimmt
# davon 35 (LOL_DEV_KEY_BATCH); ein Spieler mit ~950 Spielen dauert damit rund
# 55 Minuten. Der Lauf arbeitet die Warteschlange ab, bis der Key
# abgelaufen ist (HTTP 401 -> Exit 1, Zeile zurueck auf pending) oder das
# Spieler-Budget erschoepft ist.
# Obergrenze statt infinity: der Key lebt 24 h, danach endet der Lauf ohnehin mit
# 401. 26 h faengt also nur echte Haenger — vom 20.09. bis 30.09.2026 hing ein Lauf
# zehn Tage auf einer toten DB-Verbindung. RuntimeMaxSec= wirkt bei oneshot nicht.
TimeoutStartSec=26h
TimeoutStopSec=120
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# --rank-calls 900: nach jedem Spieler ein Rang-Zyklus mit hoechstens 900
# Riot-Anfragen (~52 min) fuer die Champion-Builds je Rang. Die Sperre wird je
# Zyklus genommen und freigegeben, der Marktwert-Lauf wartet also hoechstens
# einen Zyklus (und meldet er sich per .want an, nimmt der Sammler die Sperre gar
# nicht erst neu). Ist die Spieler-Warteschlange leer, laufen nur noch Rang-Zyklen.
# Spieler und Rang-Stichprobe teilen sich die Zeit also etwa haelftig; die 200
# Spieler sind eine Obergrenze, das Ende setzt praktisch der Key-Ablauf (401).
ExecStart=/usr/bin/node scripts/collect-lol-matches.mjs --seed --players 200 --rank-calls 900
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
# Ausnahmen dieser Unit (stehen bewusst NACH dem Boden — systemd nimmt
# bei Nicht-Listen-Direktiven die letzte Zuweisung):
#   Gemeinsame LoL-Riot-Sperre mit metastats-lol-marketvalue.service. Gleiche EROFS-Falle wie dort.
ReadWritePaths=/run/lock
