[Unit]
Description=metastats TFT snapshot bundle publisher (Vercel-Blob)
After=metastats-daily-crawl.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# Publisher fetched die Live-API einmal pro Permutation (cold path) und schreibt
# Snapshots nach Vercel-Blob. ~150 Permutationen × ~5-30s = bis zu ~15 min
# parallel, ohne Cap (TimeoutStartSec=infinity).
TimeoutStartSec=infinity
TimeoutStopSec=120
ExecStart=/usr/bin/node scripts/publish-snapshot-bundle.mjs --concurrency 3
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
# Ausnahmen dieser Unit (stehen bewusst NACH dem Boden — systemd nimmt
# bei Nicht-Listen-Direktiven die letzte Zuweisung):
#   Advisory-Lock; openSync(...,"wx") wirft EROFS und acquireLock reicht das weiter.
ReadWritePaths=/run/lock
