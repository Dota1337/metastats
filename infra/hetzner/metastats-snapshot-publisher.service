[Unit]
Description=metastats TFT snapshot bundle publisher (Vercel-Blob)
After=metastats-daily-crawl.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# Publisher fetched die Live-API einmal pro Permutation (cold path) und schreibt
# Snapshots nach Vercel-Blob. ~150 Permutationen × ~5-30s = bis zu ~15 min
# parallel, ohne Cap (TimeoutStartSec=infinity).
TimeoutStartSec=infinity
TimeoutStopSec=120
# Schwere Comp-Listen (Region alle x breite Raenge) vorab in die DB rechnen
# (Migration 0070), damit die Route sie nicht live rechnen muss. "-": ein
# Fehler hier darf den Publisher nicht blockieren — die Route rechnet dann live.
# Zuordnung Comp -> Grund-Comp (0109) vor den Listen, damit alles denselben Stand sieht.
ExecStartPre=-/usr/bin/node scripts/build-comp-merges.mjs
ExecStartPre=-/usr/bin/node scripts/precompute-comp-windows.mjs
# Comp-Verlauf als Dateien je Region x Rang (22.11.2026), Endtag von der
# Vorab-Rechnung. Eigene Frist von 10 min im Skript; "-": ein Fehler blockiert
# den Publisher nicht, die Route rechnet dann live. Tageszeilen im StateDirectory.
ExecStartPre=-/usr/bin/node scripts/publish-comp-trends.mjs
# --concurrency 1 + Pausen im Skript (22.11.2026): mit 2 gleichzeitigen Abrufen
# brachen abends 18-20 Uhr MEZ bis zu 59 Besucher-Anfragen je Stunde ab.
ExecStart=/usr/bin/node scripts/publish-snapshot-bundle.mjs --concurrency 1
# Vor dem Haertungs-Boden: apply-hardening-floor.mjs nimmt hinter dem Boden nur
# die dort eingetragenen Ausnahmen an.
StateDirectory=metastats-comp-trend
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---
# Ausnahmen dieser Unit (stehen bewusst NACH dem Boden — systemd nimmt
# bei Nicht-Listen-Direktiven die letzte Zuweisung):
#   Advisory-Lock; openSync(...,"wx") wirft EROFS und acquireLock reicht das weiter.
ReadWritePaths=/run/lock
