[Unit]
Description=metastats TFT Data Explorer: Analyse-Speicher (DuckDB) naechtlich nachfuehren
After=network-online.target postgresql.service
Wants=network-online.target
# Kein Conflicts=: die Box ist nie idle (daily-crawl bis ~17:40, Marktwert bis
# in den Vormittag). Stattdessen gibt der Build per Nice/IO-Klasse/CPU-Deckel
# nach. Er liest nur aus Postgres und schreibt ausschliesslich aufs Volume.

[Service]
Type=oneshot
WorkingDirectory=/opt/metastats-crawler
EnvironmentFile=/etc/metastats-crawler/env
# Sperre im Skript (explorer.duckdb.lock, pid + boot_id): laeuft schon ein
# Build, endet dieser Start ohne Fehler. Taeglich Teil-Aufbau (nur neu
# angekommene Partien), einmal je Woche und bei Bedarf Vollaufbau.
# Exit 2 = Vollaufbau noetig, aber heute schon gescheitert (alte Datei bleibt).
ExecStart=/usr/bin/node scripts/build-explorer-store.mjs
# Vollaufbau gemessen 2026-10-08: 3438 s. 9000 s ist Puffer fuer Tage, an
# denen die Crawls die Platte belegen; ab 6000 s meldet status.json einen Alarm.
TimeoutStartSec=9000
Nice=19
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=2G
ReadWritePaths=/mnt/HC_Volume_105869432/explorer
StandardOutput=journal
StandardError=journal

# --- BEGIN metastats-hardening-floor ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# --- END metastats-hardening-floor ---

[Install]
WantedBy=multi-user.target
