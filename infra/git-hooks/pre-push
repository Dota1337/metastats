#!/bin/sh
# Pre-push hook for metastats.
# Install: `npm run setup-hooks` (copies this file into .git/hooks/pre-push)
# Skip:    `git push --no-verify`  (explicit opt-out only)
#
# Nine gates:
#   1. TypeScript type-check        — catches obvious code regressions
#   2. Unit tests                   — node --test, catches logic regressions in
#                                     the pure lib functions
#   3. snapshot-matrix freshness    — catches Auto-Generate-Drift
#   4. Classification verifier      — catches Augment/Item/God classification
#                                     regressions against ground-truth.
#                                     See scripts/verify-classifications.mjs
#   5. system-map freshness         — catches luegende Architektur-Doku
#   6. Out-of-band drift            — catches Region-Listen + Set-Literale
#   7. Roh-Hex-Utilities            — catches Rueckfall auf -[#hex] statt Token
#   8. systemd-Haertungsboden       — catches eine neue Unit ohne Sandboxing
#   9. Disziplin-Hooks              — catches das stille Abschalten der
#                                     Plan-/Antwort-Gates. Abschalten ist
#                                     erlaubt, aber nur sichtbar im Diff.

set -e

# Gate 0: der Hook prueft seine eigene Veraltung. .git/hooks wird nicht
# gesynct und nichts triggert setup-hooks automatisch — ohne diese Zeile
# pusht Workstation 2 stumm mit einem alten Hook weiter.
if [ -f infra/git-hooks/pre-push ] && ! cmp -s "$0" infra/git-hooks/pre-push; then
  echo ""
  echo "Installierter Hook weicht von infra/git-hooks/pre-push ab — push blocked."
  echo "Run: npm run setup-hooks"
  exit 1
fi

echo "[pre-push 1/11] Running tsc --noEmit ..."
if ! npx tsc --noEmit; then
  echo ""
  echo "TypeScript errors detected — push blocked."
  exit 1
fi
echo "  tsc passed."

echo "[pre-push 2/11] Running unit tests ..."
# Frueh in der Kette: die Tests laufen in <1s und haengen an nichts, was die
# spaeteren Gates tun. Ein roter Test soll nicht hinter 60s tsc+Verifier warten.
if ! npm test; then
  echo ""
  echo "Unit tests failed — push blocked."
  exit 1
fi
echo "  unit tests passed."

echo "[pre-push 3/11] Checking snapshot-matrix.generated.mjs freshness ..."
# Wenn snapshot-matrix.ts neuer ist als die generated.mjs, ist der commit stale.
# Schützt gegen Drift im Auto-Generate-Pattern (reference_dual_module_patterns.md).
if [ -f app/lib/snapshot-matrix.ts ] && [ -f app/lib/snapshot-matrix.generated.mjs ]; then
  if [ app/lib/snapshot-matrix.ts -nt app/lib/snapshot-matrix.generated.mjs ]; then
    echo ""
    echo "snapshot-matrix.ts ist neuer als snapshot-matrix.generated.mjs — push blocked."
    echo "Run: npm run build:snapshot-matrix && git add app/lib/snapshot-matrix.generated.mjs"
    exit 1
  fi
fi
echo "  snapshot-matrix freshness OK."

echo "[pre-push 4/11] Running classification verifier ..."
if ! node scripts/verify-classifications.mjs; then
  echo ""
  echo "Classification checks failed — push blocked."
  echo "If this is intentional, re-run scripts/refresh-augment-tiers.mjs +"
  echo "scripts/fetch-tft-assets.mjs to refresh ground-truth, then retry."
  exit 1
fi
echo "  classification checks passed."

echo "[pre-push 5/11] Checking system-map freshness + broken chains ..."
# Die Karte wird generiert. Wer eine Unit anfasst und sie nicht neu baut,
# bekommt eine Architektur-Doku, die luegt — schlimmer als keine.
if ! node scripts/build-system-map.mjs --check; then
  echo ""
  echo "system-map veraltet — push blocked."
  echo "Run: npm run build:system-map && git add infra/system-map.json"
  exit 1
fi
# Kaputte Ketten (ExecStart auf fehlendes Script, OnSuccess auf unbekannte
# Unit, Timer ohne Ziel) sind Fehler. Hinweise (verwaiste Scripts, fehlende
# Vertraege) blocken bewusst nicht — sonst wird der Hook abgeschaltet.
if ! node scripts/check-system-map.mjs > /dev/null; then
  node scripts/check-system-map.mjs
  echo ""
  echo "Kaputte Referenzen in der Systemkarte — push blocked."
  exit 1
fi
echo "  system-map OK."

echo "[pre-push 6/11] Checking out-of-band region-list drift ..."
if ! node scripts/check-drift.mjs; then
  echo ""
  echo "Region-list drift detected — push blocked."
  echo "Sync the listed files with scripts/lib/active-regions.mjs, then retry."
  exit 1
fi
echo "  region-list drift check passed."

echo "[pre-push 7/11] Checking raw-hex utilities in markup ..."
# Ratsche, kein Verbot: die migrierten 10 Farben sind hart auf Null, der noch
# offene Rest (Accent, Win/Loss) darf nur nicht wachsen. Siehe Kommentarkopf
# in scripts/check-raw-hex-utilities.mjs.
if ! node scripts/check-raw-hex-utilities.mjs; then
  echo ""
  echo "Roh-Hex-Utilities im Markup — push blocked."
  exit 1
fi

echo "[pre-push 8/11] Checking angeschweisste Alpha-Suffixe ..."
# Harte Null, keine Ratsche: `${farbe}20` ist erst dann ein Fehler, wenn die
# Farbe ein Token wird — und dann verwirft der Browser die Deklaration still,
# ohne Build-Fehler. Der Bestand wurde in Commit 2b-a auf null gebracht,
# deshalb steht der Waechter sofort scharf. Siehe Kommentarkopf in
# scripts/check-color-concat.mjs.
if ! node scripts/check-color-concat.mjs; then
  echo ""
  echo "Angeschweisstes Alpha-Suffix an einem Farbwert — push blocked."
  exit 1
fi

echo "[pre-push 9/11] Checking systemd-Haertungsboden in den Unit-Files ..."
# Der Boden steht woertlich in jeder Unit statt in einem Drop-In auf der Box,
# weil build-system-map.mjs nur die Unit-Files liest — ein Drop-In unter
# /etc waere Zustand, den die Systemkarte strukturell nicht sieht. Preis des
# Duplikats ist dieser Gate: eine neue Unit ohne Boden blockt den Push.
if ! node scripts/apply-hardening-floor.mjs --check; then
  echo ""
  echo "Haertungsboden fehlt in mindestens einer Unit — push blocked."
  echo "Run: node scripts/apply-hardening-floor.mjs && git add infra/hetzner"
  exit 1
fi

echo "[pre-push 10/11] Checking Disziplin-Hooks ..."
# Die Gates gegen "erst coden, dann planen" und gegen ellenlange Berichte
# leben in .claude/settings.json — einem gitignorierten Symlink. Genau deshalb
# koennen sie stumm verschwinden (siehe 28.06., Conflicted Copy) oder in einem
# genervten Moment geloescht werden. Dieser Gate erzwingt, dass das durch
# einen Commit geht.
if ! node scripts/check-discipline-hooks.mjs; then
  echo ""
  echo "Disziplin-Hooks fehlen oder sind nicht installiert — push blocked."
  exit 1
fi

echo "[pre-push 11/11] Checking Memory-Gesundheit ..."
# Vier Verfallsarten in einem Lauf: Wikilinks ins Leere, fehlendes modified:,
# ein Vektor-Index aelter als drei Tage, und Tier-1-Regeln, die in MEMORY.md
# stehen, aber nicht in .claude/rules ausgeliefert werden. Der letzte Punkt ist
# der Grund fuer diesen Check: eine Regel, die der Index fuer aktiv haelt und
# die nie im Kontext ankommt, faellt sonst niemandem auf.
if ! node scripts/memory-health.mjs --quiet; then
  echo ""
  echo "Memory-Gesundheit: Befunde offen — push blocked."
  exit 1
fi

# --- Memory-Index nachziehen (kein Gate) ---------------------------------
# Der Indexer ist inkrementell: unveraenderte Sections werden uebersprungen
# (gemessen 2026-09-01: 0,1 s bei nichts zu tun, 3,7 s fuer 30 neue Sections).
# Er BLOCKT bewusst nicht — ein Vektor-Index ist Komfort, kein Korrektheits-Gate,
# und ein Push, der an der Memory-Pflege scheitert, wird per --no-verify umgangen.
if ! node scripts/agentdb/index-memories.mjs > /dev/null 2>&1; then
  echo "[pre-push] Hinweis: Memory-Reindex fehlgeschlagen (Push laeuft trotzdem)."
fi

echo "[pre-push] all checks green."
