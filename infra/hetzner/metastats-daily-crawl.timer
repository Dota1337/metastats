[Unit]
Description=Daily TFT all-ranks crawl — starts 00:00 UTC so all regions are fresh by late morning

[Timer]
# 00:00 UTC start: the all-regions pass runs ~9h worst-case, so it finishes
# by ~09:00 UTC (~11:00 CEST) with every region crawled before the European
# daytime traffic peaks. Giving it the full night is what guarantees "all
# regions done by the forenoon".
#
# Shared TFT prod-key bucket: the marketvalue timer still fires at 04:00 UTC,
# so the two overlap ~04:00–09:00 at half-rate. The crawl is sized for that
# (20h ceiling in the .service). If the overlap ever pushes the crawl past
# the morning, move marketvalue to start *after* the crawl window instead of
# stacking both at midnight (stacking would halve throughput the whole run).
OnCalendar=*-*-* 00:00:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
